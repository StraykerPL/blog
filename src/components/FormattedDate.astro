---
import { siteConfig } from "~/settings";

interface Props {
  date: Date;
}

const { date } = Astro.props;

const formatted = new Intl.DateTimeFormat(siteConfig.lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(date);
---

<time datetime={date.toISOString()}>{formatted}</time>
