---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const maxPostsToDisplay = 3;
const recentPosts = posts.slice(0, maxPostsToDisplay);
---

<section class="recent-posts">
  <h2 class="recent-posts__title">Recent posts</h2>
  {
    recentPosts.length > 0 ? (
      <div class="recent-posts__list">
        {recentPosts.map((post) => (
          <article class="article post-card">
            <hgroup class="article__heading-group">
              <h3 class="article__title post-card__title">
                <a
                  class="post-card__link"
                  href={`${import.meta.env.BASE_URL}/posts/${post.id}`}
                >
                  {post.data.title}
                </a>
              </h3>
              <p class="article__subtitle post-card__date">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </hgroup>
            <p class="post-card__description">{post.data.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="recent-posts__empty">No posts yet.</p>
    )
  }
</section>
