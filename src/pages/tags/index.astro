---
import { getCollection } from "astro:content";
import Base from "@layouts/Base.astro";
import TagLink from "@components/TagLink.astro";
import { getUniqueTags } from "@utils/tags";

const posts = await getCollection("blog");
//case-insensitive tag sorting
const tags = getUniqueTags(posts).sort((a, b) =>
  a.localeCompare(b, undefined, { sensitivity: "base" }),
);
---

<Base title="List of blog tags">
  <div class="tags-index">
    <h1 class="tags-index__title">Post tags</h1>
    <ul class="tags-index__list">
      {
        tags.map((tag) => (
          <li class="tags-index__item">
            <TagLink tag={tag} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>
