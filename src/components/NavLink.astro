---
const { path } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
---

<a
  href={`/blog/${path}`}
  aria-current={currentPath === path || currentPath.startsWith(path + "/")
    ? "page"
    : undefined}
>
  <slot />
</a>
