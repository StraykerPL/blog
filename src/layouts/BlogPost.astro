---
import type { CollectionEntry } from "astro:content";
import TagList from "@components/TagList.astro";
import FormattedDate from "@components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, pubDate, tags } = Astro.props;
---

<article class="article blog-post">
  <header class="article__header blog-post__header">
    <hgroup class="article__heading-group">
      <h1 class="article__title">{title}</h1>
      <p class="article__subtitle blog-post__date">
        <FormattedDate date={pubDate} />
      </p>
    </hgroup>
  </header>
  <div class="blog-post__content prose">
    <slot />
  </div>

  {
    tags && (
      <footer class="article__footer blog-post__footer">
        <TagList tags={tags} />
      </footer>
    )
  }
</article>
