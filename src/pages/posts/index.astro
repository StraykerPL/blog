---
import Base from "@layouts/Base.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";

type Post = CollectionEntry<"blog">;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postByYear: {
  [year: number]: Post[];
} = {};

posts.forEach((post) => {
  const year = post.data.pubDate.getFullYear();
  if (!postByYear[year]) {
    postByYear[year] = [];
  }
  postByYear[year].push(post);
});
---

<Base title="Posts" description="List of blog posts">
  <article class="article posts-archive">
    <header class="article__header">
      <hgroup class="article__heading-group">
        <h1 class="article__title">Posts</h1>
        <p class="article__subtitle">Moje posty</p>
      </hgroup>
    </header>
    {
      Object.keys(postByYear)
        .sort((a, b) => parseInt(b) - parseInt(a))
        .map((year) => (
          <section class="posts-archive__year" id={year}>
            <h2 class="posts-archive__title">{year}</h2>
            <ul class="posts-archive__list">
              {postByYear[parseInt(year)].map((post: Post) => (
                <li class="posts-archive__item">
                  <a
                    class="posts-archive__link"
                    href={`${import.meta.env.BASE_URL}/posts/${post.id}`}
                  >
                    {post.data.title}
                  </a>
                  <br />
                  <small class="posts-archive__date">
                    <FormattedDate date={post.data.pubDate} />
                  </small>
                </li>
              ))}
            </ul>
          </section>
        ))
    }
  </article>
</Base>
