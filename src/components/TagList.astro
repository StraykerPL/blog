---
import TagLink from "@components/TagLink.astro";

type Props = {
  tags: string[];
};

const { tags } = Astro.props;
---

<nav class="tag-list" aria-label="Tags">
  <ul class="tag-list__items">
    {
      tags.map((tag) => (
        <li class="tag-list__item">
          <TagLink tag={tag} />
        </li>
      ))
    }
  </ul>
</nav>
